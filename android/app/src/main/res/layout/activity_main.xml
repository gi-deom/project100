<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#080B0B">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GIDLIGHT"
        android:textColor="#D7F34D"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Your screen, in motion."
        android:textColor="#EDF2E9"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Choose Gidlight from Android's wallpaper picker to apply Bing images to your home screen, lock screen, or both."
        android:textColor="#89938B"
        android:textSize="15sp" />

    <Button
        android:id="@+id/chooseWallpaperButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Choose live wallpaper"
        android:textAllCaps="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Android shows the system confirmation screen before changing wallpaper. Gidlight never bypasses device permissions."
        android:textColor="#89938B"
        android:textSize="12sp" />
</LinearLayout>
